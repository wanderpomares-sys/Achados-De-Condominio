rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Administrador = quem tem um documento em admins/{uid} (criado à mão no console).
    // Equipe = quem tem um documento em admins/{uid}. Administrador = equipe sem role "mod".
    // Moderador = documento com o campo role = "mod" (modera anúncios e condomínios; não mexe em planos, patrocinados nem e-mails).
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isAdmin() { return isStaff() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'admin') != 'mod'; }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;   // só para o app saber se você é admin
      allow write: if false;                                  // criar/remover só pelo console
    }

    // Anúncios: logado lê; só o dono cria/edita/apaga. Os demais só somam +1 em views ou wants.
    // A validade nunca pode passar de ~30 dias a partir de agora (renovação = +30 dias).
    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt <= request.time.toMillis() + 31 * 24 * 60 * 60 * 1000;
      allow update: if signedIn() && (
        isStaff()
        || (resource.data.sellerUid == request.auth.uid
            && request.resource.data.sellerUid == request.auth.uid
            && request.resource.data.expiresAt <= request.time.toMillis() + 31 * 24 * 60 * 60 * 1000)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportsCount'])
            && request.resource.data.reportsCount - resource.data.get('reportsCount', 0) == 1
            && existsAfter(/databases/$(database)/documents/reports/$(id + '_' + request.auth.uid))
            && !exists(/databases/$(database)/documents/reports/$(id + '_' + request.auth.uid)))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views','wants'])
            && request.resource.data.views - resource.data.views <= 1
            && request.resource.data.wants - resource.data.wants <= 1));
      allow delete: if signedIn() && (resource.data.sellerUid == request.auth.uid || isStaff());
    }

    // Perfil (inclui e-mail para os avisos): cada um lê e grava só o próprio; admin também.
    match /users/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Interesses ("Quero"): o usuário cria o seu; só ele lê.
    match /interests/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Condomínios: todos leem; qualquer logado cadastra (endereço obrigatório); só o admin altera/apaga.
    match /condos/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ['approved', 'pending']
        && request.resource.data.name is string && request.resource.data.name.size() > 1
        && request.resource.data.endereco is string && request.resource.data.endereco.size() > 4
        && request.resource.data.bairro is string && request.resource.data.bairro.size() > 1
        && request.resource.data.cidade is string && request.resource.data.cidade.size() > 1
        && (!('lat' in request.resource.data) || (request.resource.data.lat is number && request.resource.data.lng is number));
      allow update, delete: if isStaff();
    }

    // Denúncias: uma por pessoa por anúncio (id = postId_uid); só o admin lê.
    match /reports/{rid} {
      allow create: if signedIn() && rid == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow read: if isStaff();
    }

    // Plano anual: só o administrador ativa; o dono lê o próprio plano.
    match /plans/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    // Pedidos de plano (depois de pagar o Pix): o morador cria o seu; o admin lê e apaga.
    match /planRequests/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow read, delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Patrocinados (R$ 29,90/semana): o comerciante cria como "pending"; só o admin ativa/apaga.
    match /sponsors/{id} {
      allow read: if signedIn() && (resource.data.status == 'active' || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 80
        && (!('sub' in request.resource.data) || request.resource.data.sub.size() <= 140)
        && (!('link' in request.resource.data) || request.resource.data.link.size() <= 300);
      allow update, delete: if isAdmin();
    }

    // Enquetes: um voto por pessoa (id = postId_uid), sem trocar nem apagar.
    // O contador fica num único documento (pollStats), então abrir uma enquete custa só 2 leituras.
    match /votes/{vid} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if signedIn() && vid == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.choice is int
        && request.resource.data.choice >= 0 && request.resource.data.choice <= 4;
      allow delete: if isStaff();
    }
    function cnt(d, i) { return d.get('c' + string(i), 0); }
    match /pollStats/{pid} {
      allow read: if signedIn();
      // soma +1 no total, junto com a criação do próprio voto (mesmo lote)
      allow create, update: if signedIn()
        && existsAfter(/databases/$(database)/documents/votes/$(pid + '_' + request.auth.uid))
        && !exists(/databases/$(database)/documents/votes/$(pid + '_' + request.auth.uid))
        && request.resource.data.keys().hasOnly(['c0','c1','c2','c3','c4'])
        && (cnt(request.resource.data,0)+cnt(request.resource.data,1)+cnt(request.resource.data,2)+cnt(request.resource.data,3)+cnt(request.resource.data,4))
           - (resource == null ? 0 : (cnt(resource.data,0)+cnt(resource.data,1)+cnt(resource.data,2)+cnt(resource.data,3)+cnt(resource.data,4))) == 1;
    }

    // Perguntas entre vizinhos: respostas curtas; o autor ou a equipe apagam.
    match /answers/{aid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isStaff());
    }

    // Fila de e-mails (extensão "Trigger Email"): só o servidor escreve.
    match /mail/{id} { allow read, write: if false; }
  }
}
